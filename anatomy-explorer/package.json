{
  "name": "anatomy-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "audit:models": "tsx scripts/audit-models.ts",
    "postinstall": "node scripts/copy-draco.mjs",
    "fetch:skeleton": "python3 scripts/fetch-models.py --system skeleton",
    "build:skeleton": "tsx scripts/build-skeleton.ts",
    "check:skeleton": "tsx scripts/check-skeleton.ts",
    "fetch:muscles": "python3 scripts/fetch-models.py --system muscles",
    "build:muscles": "tsx scripts/build-muscles.ts",
    "check:viewer": "tsx scripts/check-viewer.ts",
    "check": "npm run build && npm run audit:models && npm run check:skeleton && npm run check:viewer",
    "format": "prettier --write src scripts/*.{ts,mjs} *.json *.md",
    "format:check": "prettier --check src scripts/*.{ts,mjs} *.json *.md"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "lucide-react": "^1.73.0",
    "maath": "^0.10.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "draco3dgltf": "^1.5.9",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
