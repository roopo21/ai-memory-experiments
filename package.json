{
  "name": "anatomy-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "postinstall": "node asset-pipeline/fetch/copy-draco.mjs",
    "check": "npm run build && npm run check:models && npm run check:skeleton && npm run check:viewer && npm run check:organs && npm run check:nerves && npm run check:guides && npm run check:previews && npm run check:pose && npm run check:studio",
    "check:models": "tsx checks/check-models.ts",
    "check:skeleton": "tsx checks/check-skeleton.ts",
    "check:viewer": "tsx checks/check-viewer.ts",
    "check:organs": "tsx checks/check-organs.ts",
    "check:nerves": "tsx checks/check-nerves.ts",
    "check:guides": "tsx checks/check-guides.ts",
    "check:previews": "tsx checks/check-previews.ts",
    "check:pose": "tsx checks/check-pose.ts",
    "format": "prettier --write src asset-pipeline checks \"*.{json,md,ts}\" docs",
    "format:check": "prettier --check src asset-pipeline checks \"*.{json,md,ts}\" docs",
    "fetch:skeleton": "python3 asset-pipeline/fetch/fetch-models.py --system skeleton",
    "fetch:muscles": "python3 asset-pipeline/fetch/fetch-models.py --system muscles",
    "fetch:organs": "python3 asset-pipeline/fetch/fetch-models.py --system organs",
    "fetch:nerves": "python3 asset-pipeline/fetch/fetch-nerves.py",
    "select:muscles": "python3 asset-pipeline/select/select-muscles.py",
    "select:organs": "python3 asset-pipeline/select/select-organs.py",
    "select:nerves": "tsx asset-pipeline/select/select-nerves.ts",
    "register:nerves": "tsx asset-pipeline/build/register-zanatomy.ts",
    "build:skeleton": "tsx asset-pipeline/build/build-skeleton.ts",
    "build:muscles": "tsx asset-pipeline/build/build-muscles.ts",
    "build:organs": "tsx asset-pipeline/build/build-organs.ts",
    "build:nerves": "tsx asset-pipeline/build/build-nerves.ts",
    "build:previews": "tsx asset-pipeline/build/build-previews.ts",
    "build:motion-avatar": "tsx asset-pipeline/motion/build-avatar.ts",
    "render:motion": "tsx asset-pipeline/motion/render.mjs",
    "check:glide-views": "tsx checks/check-glide-views.ts",
    "check:studio": "npm run check:glide-views && tsx checks/check-guide-motion.ts && npm run check:form && npm run check:hands && tsx checks/check-studio.ts && tsx checks/studio-surfaces.ts && npm run check:studio:geometry",
    "check:form": "tsx checks/check-form.ts --quiet",
    "stills:guides": "tsx checks/studio-stills.mjs",
    "check:studio:surfaces": "tsx checks/studio-surfaces.ts --dense",
    "check:studio:browser": "node checks/studio-browser.mjs",
    "build:articulation": "tsx asset-pipeline/motion/build-articulation.ts",
    "build:studio-assets": "npm run build:articulation && npm run build:motion-avatar && tsx asset-pipeline/motion/build-contact-cloud.ts && tsx asset-pipeline/motion/build-guide-contacts.ts",
    "check:studio:geometry": "tsx checks/studio-guide-geometry.ts",
    "check:studio:library": "tsx checks/studio-library-browser.mjs",
    "render:guides": "tsx checks/studio-library-browser.mjs --record",
    "check:studio:cards": "tsx checks/studio-guide-entry.mjs",
    "check:hands": "tsx checks/check-hands.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "lucide-react": "^1.73.0",
    "maath": "^0.10.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "draco3dgltf": "^1.5.9",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
